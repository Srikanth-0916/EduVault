# APAAR-SDMV API — development environment template.
# Copy to .env (never commit .env) and adjust for local use.

# development | test | production (production refuses the dev defaults below)
ENV=development

# Postgres in docker compose; SQLite (sqlite:///./var/local.db) for quick local runs
DATABASE_URL=postgresql+psycopg://apaar:apaar@db:5432/apaar_sdmv

# Secrets: replace with strong random values (e.g. `openssl rand -hex 32`).
JWT_SECRET=replace-me-with-a-strong-random-value
APAAR_ENCRYPTION_KEY=replace-me-with-a-fernet-key
APAAR_LOOKUP_KEY=replace-me-with-a-strong-random-value
RECEIPT_SIGNING_KEY=replace-me-with-a-strong-random-value

# Access-token lifetime (minutes)
ACCESS_TOKEN_MINUTES=30

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Public web origin used when building student verification links.
WEB_BASE_URL=http://localhost:3000

# Development only: seed the deterministic synthetic demo dataset at startup.
# Ignored in test/production. Set false when using an existing database.
AUTO_SEED=true

# Web → API base URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Web port
WEB_PORT=3000
